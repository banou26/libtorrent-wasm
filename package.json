{
  "name": "libtorrent-wasm",
  "version": "0.3.30",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/banou26/libtorrent-wasm.git"
  },
  "description": "libtorrent compiled to WebAssembly, single-threaded, transport over FKN WebVPN",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    },
    "./opfs": {
      "types": "./build/opfs.d.ts",
      "import": "./build/opfs.js"
    },
    "./types": {
      "types": "./build/types.d.ts",
      "import": "./build/types.js"
    },
    "./webtorrent": {
      "types": "./build/webtorrent/index.d.ts",
      "import": "./build/webtorrent/index.js"
    },
    "./webtorrent/page": {
      "types": "./build/webtorrent/page.d.ts",
      "import": "./build/webtorrent/page.js"
    },
    "./webrtc": {
      "types": "./build/webrtc/index.d.ts",
      "import": "./build/webrtc.js"
    },
    "./webrtc.wasm": {
      "default": "./build/webrtc.wasm"
    }
  },
  "scripts": {
    "dev": "concurrently \"npm run dev-wasm\" \"npm run vite-build-dev\"",
    "dev-wasm": "nodemon -e cpp,hpp,js --watch src --exec \"npm run make-docker\"",
    "make-docker": "docker compose run --rm libtorrent-wasm make dist",
    "docker-clean": "docker compose up --remove-orphans",
    "vite-build": "vp build",
    "vite-build-dev": "vp build --watch",
    "build": "npm run make-docker && npm run copy-wasm && npm run build:webrtc",
    "build:webrtc": "npm run webrtc-wasm && npm run vite-build && npm run types",
    "webrtc-wasm": "node webrtc/patch-sctp-proto.mjs && cd webrtc && RUSTFLAGS=\"--remap-path-prefix=${CARGO_HOME:-$HOME/.cargo}=cargo --remap-path-prefix=$PWD=webrtc\" cargo build --release --locked --target wasm32-wasip1 && cd .. && copyfiles -f webrtc/target/wasm32-wasip1/release/webrtc.wasm build",
    "prepublishOnly": "npm run build",
    "types": "tsc",
    "copy-wasm": "copyfiles -u 1 dist/libtorrent.js dist/libtorrent.wasm build",
    "test": "node --test --test-timeout=60000 \"tests/**/*.test.mjs\"",
    "test:ci": "node --test --test-timeout=60000 $(ls tests/*.test.mjs | grep -v -e rate-limits -e forget-pieces-swarm) tests/webtorrent/*.test.mjs",
    "test:webrtc": "node --test --test-timeout=120000 \"tests/webrtc/*.test.mjs\"",
    "test:fd-lifecycle": "node scripts/test-fd-lifecycle.mjs",
    "test:swarm": "node tests/rig/run.mjs",
    "test:bad-peer": "node tests/rig/bad-swarm.mjs"
  },
  "dependencies": {
    "@banou/ponyfill": "^0.0.15"
  },
  "peerDependencies": {
    "@fkn/lib": ">=0.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/emscripten": "^1.40.0",
    "bittorrent-tracker": "^11.2.3",
    "concurrently": "^7.6.0",
    "copyfiles": "^2.4.1",
    "node-datachannel": "0.32.3",
    "nodemon": "^2.0.22",
    "playwright": "^1.60.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
    "vite-plus": "0.3.3"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
    "vitest": "4.1.11"
  }
}

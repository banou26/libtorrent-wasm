From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Banou <me@banou.dev>
Date: Sat, 14 Nov 2026 22:00:00 +0900
Subject: [PATCH] fix: a name answered after the session is gone reaches no resolver

---
diff --git a/include/libtorrent/aux_/resolver.hpp b/include/libtorrent/aux_/resolver.hpp
--- a/include/libtorrent/aux_/resolver.hpp
+++ b/include/libtorrent/aux_/resolver.hpp
@@ -68,6 +68,7 @@ struct TORRENT_EXTRA_EXPORT resolver final : resolver_interface
 	// pointer. Caller posts this onto the io_context.
 	void wasm_complete(std::string host, std::string ip_csv);
 	io_context* ios_ptr() { return &m_ios; }
+	~resolver();
 #endif
 
 private:
diff --git a/src/resolver.cpp b/src/resolver.cpp
--- a/src/resolver.cpp
+++ b/src/resolver.cpp
@@ -74,6 +74,15 @@ namespace aux {
 #endif
 	}
 
+#ifdef __EMSCRIPTEN__
+	// WASM patch: a name answered after the session is gone (lt_dns_complete) finds no resolver,
+	// where it found this one freed.
+	resolver::~resolver()
+	{
+		if (g_active_resolver == this) g_active_resolver = nullptr;
+	}
+#endif
+
 namespace {
 	void callback(resolver_interface::callback_t h
 		, error_code const& ec, std::vector<address> const& ips)
